# ====================================================================
# FOCO NA FARDA - ENVIRONMENT CONFIGURATION (.env.example)
# AVISO DE SEGURANÇA: NUNCA exponha chaves secretas ou Service Role ao frontend!
# ====================================================================

# 1. GEMINI_API_KEY (SERVER-SIDE ONLY)
# Utilizada EXCLUSIVAMENTE pelo backend Node/Express em server.ts para chamadas de IA.
# NUNCA prefixar com VITE_ nem expor ao cliente.
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# 2. APP_URL
# URL canônica da aplicação no Cloud Run / ambiente de produção.
APP_URL="http://localhost:3000"

# 3. SUPABASE CLIENT-SIDE CONFIG (PUBLIC ANON KEY)
# Estas variáveis públicas são utilizadas pelo cliente React (@supabase/supabase-js).
# A Anon Key possui permissões limitadas pelo Row Level Security (RLS) do PostgreSQL.
VITE_SUPABASE_URL="https://exemplo-seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemploAnonKey"

# 4. SUPABASE SERVICE ROLE / SECRET KEY (SERVER-SIDE ONLY - CRÍTICO)
# PROIBIDO NO FRONTEND! O Service Role ignora todas as políticas de RLS e NUNCA
# pode ser prefixado com VITE_ nem incluído no código que roda no navegador do usuário.
SUPABASE_SERVICE_ROLE_KEY=""
